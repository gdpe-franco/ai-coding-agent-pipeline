# App environment and log verbosity.
APP_ENV=development
LOG_LEVEL=info

# Coder generations per round, and the lifetime run cap per project.
MAX_CODER_ATTEMPTS=3
MAX_RUNS_PER_PROJECT=100

# PostgreSQL login role and database.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
# Host-side development URL. Compose overrides the host with its db service name.
DATABASE_URL=postgresql+asyncpg://app:change-me@localhost:5432/app

# Replace with a generated strong JWT signing key.
SECRET_KEY=change-me-generate-a-strong-value

# External URLs used by links, CORS, and previews.
PUBLIC_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
PREVIEW_HOST=http://preview.localhost:8000

# Azure OpenAI endpoint, key, and developer-specific deployment names.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT_PLANNER=
AZURE_OPENAI_DEPLOYMENT_CODER=
AZURE_OPENAI_DEPLOYMENT_REVIEWER=

# Shared rate limiter and proxy trust.
RATE_LIMIT_ENABLED=true
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
